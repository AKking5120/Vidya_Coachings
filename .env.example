# Supabase (required for reviews, notices, leaderboard)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key

# Student bot AI — FREE Google Gemini key (server-side only, do NOT prefix with VITE_)
# Get free key: https://aistudio.google.com/apikey
# Add this in Vercel dashboard → Settings → Environment Variables
GEMINI_API_KEY=your_gemini_api_key

# Optional: GitHub gallery images
VITE_GITHUB_REPO=owner/repo
VITE_GITHUB_BRANCH=main
